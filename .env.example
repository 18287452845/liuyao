# Database
# Connection pool settings: connection_limit, pool_timeout
DATABASE_URL="mysql://username:password@localhost:3306/divination_db?connection_limit=10&pool_timeout=20&connect_timeout=10"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# DeepSeek API
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Environment
NODE_ENV="development"

# Database Optimization (Optional)
# PRISMA_QUERY_ENGINE_BINARY_PATH="/custom/path/to/query-engine"
# PRISMA_CLIENT_FORCE_LAZY_LOADING="true"